# ============================================================================
# Variables d'environnement — Oracle Cloud Deployment
# ============================================================================
# Copie ce fichier : cp deploy/oracle/.env.example .env
# Puis édite les valeurs ci-dessous
# ============================================================================

# --- Django ------------------------------------------------------------------
# Génère une clé secrète : python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_AVEC_UNE_CLE_SECRETE

# Mettre à True en développement, False en production
DEBUG=False

# --- Domaine / IP ------------------------------------------------------------
# L'IP publique de ton instance Oracle OU ton nom de domaine
ALLOWED_HOSTS=129.154.xx.xx,localhost,127.0.0.1

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=https://suponeai.netlify.app

# --- Base de données ---------------------------------------------------------
# Option 1 : SQLite (simple, pas de config)
DATABASE_URL=sqlite:////home/ubuntu/SupOneAI/backend/db.sqlite3

# Option 2 : PostgreSQL Docker (recommandé pour la prod)
# DATABASE_URL=postgres://supone:SUPER_MOT_DE_PASSE@db:5432/supone

# --- Gemini API --------------------------------------------------------------
GEMINI_API_KEY=TA_CLE_GEMINI_API_ICI
GEMINI_MODEL=gemini-2.0-flash

# --- Gunicorn ----------------------------------------------------------------
PORT=8001
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120

# --- Bootstrap (premier lancement) ------------------------------------------
# Mettre à 1 pour charger les données initiales (FAQ, etc.)
RUN_BOOTSTRAP=0
SKIP_GEN3=0

# --- Hugging Face (offline mode pour ARM) -----------------------------------
HF_OFFLINE=1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
